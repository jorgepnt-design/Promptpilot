# Adresse des Sync-Dienstes (Render). Ohne diesen Wert arbeitet die App rein lokal.
VITE_API_URL=https://promptpilot-server.onrender.com

# OAuth-Client-ID aus der Google Cloud Console.
# Dieser Wert ist nicht geheim und landet bewusst im Browser-Build.
# Das zugehörige Client-Secret wird NICHT benötigt.
VITE_GOOGLE_CLIENT_ID=1234567890-beispiel.apps.googleusercontent.com
